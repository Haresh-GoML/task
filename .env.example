# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# JWT Secrets (Generate random strings for production)
JWT_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here

# Server Configuration
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
